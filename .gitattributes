# Scripts must keep the line endings their interpreter needs, whatever the contributor's git settings.
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Source files: git decides text vs binary and normalises new content to LF in the repository.
*.java text=auto
*.ts   text=auto
*.tsx  text=auto
*.js   text=auto
*.jsx  text=auto
*.json text=auto
*.css  text=auto
*.html text=auto
*.sql  text=auto
*.py   text=auto
*.md   text=auto
