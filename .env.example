# ====================================================================
# MAHARAJA INSTITUTE OF TECHNOLOGY MYSORE - EXAMINATION MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env before starting services:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# ====================================================================

# --------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# --------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=campusexam_test
DB_USER=campusexam
DB_PASSWORD=password
DB_URL=jdbc:postgresql://localhost:5432/campusexam_test
ALLOW_ANY_DB=false

# --------------------------------------------------------------------
# 2. CENTRAL BACKENDS (server.js - Port 8080 & CampusExam.java - Port 8081)
# --------------------------------------------------------------------
# JWT Secret for backend/server.js authentication (minimum 32 characters required).
# Generate a secure value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=8081
BIND=127.0.0.1
CENTRAL_URL=http://127.0.0.1:8081
CENTRAL_KEYS_DIR=keys
LAB_SERVER_URL=http://127.0.0.1:8082

# Origins the Node backend (backend/server.js) accepts browser calls from, comma-separated.
# Empty = its built-in default (the local portal ports on localhost / 127.0.0.1).
ALLOWED_ORIGINS=

# Safety switches. All three must be false for a real examination: deploy/preflight refuses to start otherwise.
#   LAB_TEST_MODE           true lets a client set the lab server's clock and enables test/* routes.
#   LAB_STAFF_ALLOW_REMOTE  true opens the unauthenticated staff routes to any caller that can reach port 8082.
#   ALLOW_SAMPLE_EXAM       true makes backend/server.js invent a sample paper when none is scheduled.
LAB_TEST_MODE=false
LAB_STAFF_ALLOW_REMOTE=false
ALLOW_SAMPLE_EXAM=false

# --------------------------------------------------------------------
# 3. INDEPENDENT LAB SERVER (LabServer.java - Port 8082)
# --------------------------------------------------------------------
LAB_ID=LAB-CSE-01
LAB_PORT=8082
LAB_BIND=127.0.0.1
LAB_KEYS_DIR=lab_server_keys
LAB_STORAGE_DIR=lab_storage/packages
# Instructor (invigilator) login. Both must be set or instructor login is disabled.
# Generate the hash with deploy/make-instructor-credential.ps1 or .sh.
LAB_INSTRUCTOR_USERNAME=
LAB_INSTRUCTOR_PASSWORD_HASH=

# --------------------------------------------------------------------
# 3b. EXAM GATEWAY (deploy/gateway/server.js) - the only service Tailscale Funnel points at
# --------------------------------------------------------------------
# Serves the built student portal and forwards only the student routes to the lab server.
# Used instead of the student dev server below (STUDENT_PORT), so do not run both on one port.
GATEWAY_PORT=3002
# Name of the request header that carries the caller's IP behind Funnel. Leave empty until you have read
# the gateway log (see DEPLOYMENT.md, "Gateway").
CLIENT_IP_HEADER=
# Where to copy lab_storage after the sitting. deploy/preflight checks that this folder is writable.
BACKUP_DIR=backups

# --------------------------------------------------------------------
# 4. FRONTEND APPLICATIONS
# --------------------------------------------------------------------
# Admin / HOD Portal (Port 3000)
VITE_API_BASE_URL=http://127.0.0.1:8081/api/v1
DEFAULT_APP_PORT=3000

# COE Portal (Port 3001)
COE_PORT=3001
VITE_LAB_API_BASE_URL=http://127.0.0.1:8082/lab-api

# Student Examination Portal (Port 3002)
STUDENT_PORT=3002
VITE_API_URL=http://127.0.0.1:8082
VITE_API_TIMEOUT_MS=8000

# --------------------------------------------------------------------
# 5. MULTI-LAPTOP / LAN CONFIGURATION (Optional for LAN mode)
# When running across multiple laptops on the same Wi-Fi / Ethernet:
# Set BIND=0.0.0.0, LAB_BIND=0.0.0.0 and replace 127.0.0.1 with the
# Host Laptop's LAN IP address (e.g., 192.168.1.50).
# The frontends will also auto-detect the host IP from the browser URL.
# NEVER for an exam over Tailscale: deploy/start-exam refuses any bind other than 127.0.0.1.
# --------------------------------------------------------------------
# BIND=0.0.0.0
# LAB_BIND=0.0.0.0

# --------------------------------------------------------------------
# 6. DOCUMENT CONVERTER SERVER (admin-portal (7)/server/converter - Port 5001)
# --------------------------------------------------------------------
CONVERTER_PORT=5001
VITE_CONVERTER_URL=http://127.0.0.1:5001/api

